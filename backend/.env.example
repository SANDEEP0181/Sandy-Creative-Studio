# Copy to .env for local development. Never commit real secrets.
PORT=8787
NODE_ENV=development
# Comma-separated exact frontend origins. For GitHub Pages, allow the origin only.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:5500,https://sandeep0181.github.io

# Existing optional OpenAI text-generation provider. Keep keys server-side.
OPENAI_API_KEY=
OPENAI_MODEL=

# OptimAI Router: used only for read-only model discovery in this integration phase.
# Create/store the key in the backend host's secret environment; never commit it.
OPTIMAI_ROUTER_BASE_URL=https://api-router.optimai.network/v1
OPTIMAI_ROUTER_API_KEY=

# Paid OptimAI inference is intentionally not implemented or enabled in this phase.
