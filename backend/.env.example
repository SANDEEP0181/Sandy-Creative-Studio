# Copy to .env for local development. Never commit real secrets.
PORT=8787
NODE_ENV=development
# Comma-separated exact frontend origins. For GitHub Pages, allow the origin only.
ALLOWED_ORIGINS=http://localhost:8787,http://127.0.0.1:5500,https://sandeep0181.github.io

# Optional text-generation provider. Add these only to the backend host's secret settings.
# Get a key from your provider account; never place it in index.html or GitHub source.
OPENAI_API_KEY=
OPENAI_MODEL=

# Reserved for a future verified OptimAI Search adapter. Not used by the current code.
OPTIMAI_API_KEY=